# ---------------------------------------------------------------------------
# Backend environment. Copy to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

ENV=dev
DEBUG=true

# Database (asyncpg driver is required)
# Local (docker compose): host "db"; direct local run: "localhost"
DATABASE_URL=postgresql+asyncpg://myschoolproject:myschoolproject@localhost:5432/myschoolproject

# Cache / background queue (reserved for stage 5)
REDIS_URL=redis://localhost:6379/0

# Rate limiting: memory (single process) or redis (multi-worker prod).
RATE_LIMIT_BACKEND=memory

# Observability: Prometheus endpoint /api/v1/metrics and HSTS behind HTTPS.
METRICS_ENABLED=true
HSTS_ENABLED=false

# Public backend URL used by the frontend proxy / BFF
BACKEND_URL=http://localhost:8000

# Auth. JWT_SECRET MUST be >= 32 chars in production and never a default.
JWT_SECRET=change-me-please-change-me-please-32
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
# Extra origins allowed to send state-changing requests (CSRF guard).
# Leave empty in dev; in prod CORS/CSRF origins are enforced.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Topic checks
TOPIC_DUPLICATE_WARN=0.55
TOPIC_DUPLICATE_BLOCK=0.85
TOPIC_BROADNESS_OK=70
TOPIC_BROADNESS_WARN=40

# Dashboard thresholds
INACTIVITY_YELLOW_DAYS=7
INACTIVITY_RED_DAYS=14
CHECKPOINT_SOON_DAYS=7
CHECKLIST_SOON_DAYS=3
CHECKLIST_STALLED_DAYS=14
FINAL_FILE_DAYS_BEFORE=14
REVIEW_WAIT_DAYS=5

# File storage: local (dev) or s3 (prod)
STORAGE_BACKEND=local
MEDIA_ROOT=media
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_PROJECT=10
ALLOWED_UPLOAD_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/png,image/jpeg,application/zip
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.pptx,.png,.jpg,.jpeg,.zip

# S3 (only when STORAGE_BACKEND=s3)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# Email (optional, stage 5)
# EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
