# Environment for docker compose (deploy/).
# Copy to `deploy/.env`. Never commit real secrets.

# Production REQUIRES POSTGRES_PASSWORD (compose fails without it).
POSTGRES_USER=myschoolproject
POSTGRES_PASSWORD=
POSTGRES_DB=myschoolproject

# Backend also reads backend/.env; keep the two in sync for DATABASE_URL/JWT_SECRET.
# In prod set CORS_ORIGINS and CSRF_TRUSTED_ORIGINS to the public origin,
# e.g. https://project.school.example (comma-separated for several).
