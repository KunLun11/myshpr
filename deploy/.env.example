# Environment for docker compose (deploy/).
# Copy to `deploy/.env`. Never commit real secrets.
#
# Production REQUIRES POSTGRES_PASSWORD, REDIS_PASSWORD, DOMAIN and a strong
# JWT_SECRET. The backend refuses to start with demo defaults in prod:
# values containing `CHANGE-ME` are rejected, so replace every placeholder.
#
# `deploy/.env` is the single source of truth for the prod stack: every
# variable below is forwarded to the containers by docker-compose.prod.yml.
# `backend/.env` is optional on a server (see docs/env.md).

# --- Public entrypoint (Caddy, automatic HTTPS) ---------------------------
DOMAIN=project.school.example
ACME_EMAIL=admin@school.example

# --- Database -------------------------------------------------------------
POSTGRES_USER=myschoolproject
POSTGRES_PASSWORD=CHANGE-ME-STRONG-DB-PASSWORD
POSTGRES_DB=myschoolproject

# --- Redis ----------------------------------------------------------------
# Keep REDIS_PASSWORD and REDIS_URL in sync. Redis is not published to the host.
# URL-encode special characters in the password (`@` -> %40, `/` -> %2F).
REDIS_PASSWORD=CHANGE-ME-STRONG-REDIS-PASSWORD
REDIS_URL=redis://:CHANGE-ME-STRONG-REDIS-PASSWORD@redis:6379/0

# --- Backend: required ----------------------------------------------------
# DATABASE_URL must use the asyncpg driver and the same credentials as
# POSTGRES_* above. Substituting the password here is a manual step.
ENV=prod
DEBUG=false
DATABASE_URL=postgresql+asyncpg://myschoolproject:CHANGE-ME-STRONG-DB-PASSWORD@db:5432/myschoolproject
BACKEND_URL=http://backend:8000
JWT_SECRET=CHANGE-ME-AT-LEAST-32-CHARACTERS-LONG
CORS_ORIGINS=https://project.school.example
CSRF_TRUSTED_ORIGINS=https://project.school.example

# --- Backend: auth (optional, defaults shown) -----------------------------
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# --- Backend: platform flags ---------------------------------------------
# The backend runs multiple uvicorn workers: shared counters are mandatory.
RATE_LIMIT_BACKEND=redis
METRICS_ENABLED=true
HSTS_ENABLED=true

# --- Topic check thresholds (optional) ------------------------------------
# TOPIC_DUPLICATE_WARN=0.55
# TOPIC_DUPLICATE_BLOCK=0.85
# TOPIC_BROADNESS_OK=70
# TOPIC_BROADNESS_WARN=40

# --- Dashboard / reminder thresholds (optional) ---------------------------
# INACTIVITY_YELLOW_DAYS=7
# INACTIVITY_RED_DAYS=14
# CHECKPOINT_SOON_DAYS=7
# CHECKLIST_SOON_DAYS=3
# CHECKLIST_STALLED_DAYS=14
# FINAL_FILE_DAYS_BEFORE=14
# REVIEW_WAIT_DAYS=5

# --- Files ----------------------------------------------------------------
# Local disk uses the `media_data` volume mounted at /app/media (do not change
# MEDIA_ROOT). S3 is recommended for multiple hosts.
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_PROJECT=10
# ALLOWED_UPLOAD_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/png,image/jpeg,application/zip
# ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.pptx,.png,.jpg,.jpeg,.zip

# S3 (only when STORAGE_BACKEND=s3). Bucket must be private + versioned.
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_BUCKET=my-school-project
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=ru-1

# --- Email (reserved: the app does not send email yet) --------------------
# EMAIL_FROM=noreply@school.example
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Backups (deploy/scripts/backup.sh reads these) -----------------------
# Must be an absolute path writable by the cron user, on a separate disk.
BACKUP_DIR=/var/backups/my-school-project
BACKUP_KEEP_DAYS=30

